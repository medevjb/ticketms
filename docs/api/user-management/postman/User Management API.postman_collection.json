{
  "info": {
    "_postman_id": "d2f9629e-8239-41f1-9d5b-7a44fb7215d1",
    "name": "TicketMS User Management API",
    "description": "Admin-only customer user management API. Import the matching environment, set baseUrl and admin credentials, then issue a token. Tokens expire after eight hours.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "token", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "adminEmail", "value": "" },
    { "key": "adminPassword", "value": "", "type": "secret" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Issue user-management token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\",\n  \"token_name\": \"Postman\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/token", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "token"] }
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Token issued', () => pm.response.to.have.status(200));",
                "if (pm.response.code === 200) {",
                "  pm.environment.set('token', pm.response.json().data.access_token);",
                "  pm.test('Token has an expiry', () => pm.expect(pm.response.json().data.expires_at).to.be.a('string'));",
                "}"
              ]
            }
          }]
        },
        {
          "name": "Revoke current token",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/token", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "token"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": ["pm.test('Token revoked', () => pm.response.to.have.status(200));", "if (pm.response.code === 200) pm.environment.unset('token');"] }
          }]
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/users?search=&status=active&per_page=25&page=1", "host": ["{{baseUrl}}"], "path": ["api", "v1", "users"], "query": [{ "key": "search", "value": "" }, { "key": "status", "value": "active" }, { "key": "per_page", "value": "25" }, { "key": "page", "value": "1" }] }
          }
        },
        {
          "name": "Create customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman Customer\",\n  \"email\": \"postman-customer@example.test\",\n  \"password\": \"LongCustomerPassword123!\",\n  \"password_confirmation\": \"LongCustomerPassword123!\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/v1/users", "host": ["{{baseUrl}}"], "path": ["api", "v1", "users"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": ["pm.test('Customer created', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) pm.environment.set('userId', pm.response.json().data.id);"] }
          }]
        },
        {
          "name": "Show user",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": { "raw": "{{baseUrl}}/api/v1/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "users", "{{userId}}"] } }
        },
        {
          "name": "Update user",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman Customer Updated\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/v1/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "users", "{{userId}}"] }
          }
        },
        {
          "name": "Deactivate user",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"is_active\": false\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/v1/users/{{userId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "v1", "users", "{{userId}}", "status"] }
          }
        },
        {
          "name": "Activate user",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"is_active\": true\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/v1/users/{{userId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "v1", "users", "{{userId}}", "status"] }
          }
        },
        {
          "name": "Archive user",
          "request": { "method": "DELETE", "header": [{ "key": "Accept", "value": "application/json" }], "url": { "raw": "{{baseUrl}}/api/v1/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "users", "{{userId}}"] } }
        },
        {
          "name": "Restore user",
          "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }], "url": { "raw": "{{baseUrl}}/api/v1/users/{{userId}}/restore", "host": ["{{baseUrl}}"], "path": ["api", "v1", "users", "{{userId}}", "restore"] } }
        }
      ]
    }
  ]
}
